"""
Platformz Dealer Locator - Get coordinates from address fields.
"""
type Query {
  """
  Returns latitude/longitude for the provided address fields.
  """
  dealerLocatorCoordinates(input: DealerLocatorAddressInput!): DealerLocatorCoordinates
    @resolver(class: "Platformz\\DealerLocator\\Model\\Resolver\\DealerLocatorCoordinates")
}

"""
Input fields used to build the geocoding query.
All fields are optional, but at least one must be provided.
"""
input DealerLocatorAddressInput {
  address: String
  city: String
  state: String
  country: String
  pin: String
}

"""
Coordinates returned from geocoding.
"""
type DealerLocatorCoordinates {
  latitude: Float!
  longitude: Float!
  display_name: String
}

